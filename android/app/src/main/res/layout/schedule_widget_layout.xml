<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:orientation="vertical"
    android:background="@drawable/home_widget_background"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="32dp"
        android:gravity="center_vertical"
        android:text="@string/home_widget_label_schedule"
        android:textColor="@color/home_widget_label"
        android:textSize="11sp"
        android:letterSpacing="0.1" />

    <!-- Column headers, mirroring the read-only スケジュール screen's DataTable header row
         (label column has no header there either). minWidth values here match
         schedule_widget_list_item.xml's own column minWidths so headers and data broadly
         line up — RemoteViews rows are inflated independently, so this can't be pixel-exact
         the way a real DataTable auto-sizes columns from every row's content, but it keeps
         the common case aligned. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="44dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="60dp"
            android:text="@string/home_widget_schedule_header_date"
            android:textColor="@color/home_widget_label"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="56dp"
            android:text="@string/home_widget_schedule_header_chain_gap"
            android:textColor="@color/home_widget_label"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="56dp"
            android:text="@string/home_widget_schedule_header_today_gap"
            android:textColor="@color/home_widget_label"
            android:textSize="10sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/schedule_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/schedule_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/home_widget_schedule_empty"
        android:textColor="@color/home_widget_white"
        android:textSize="14sp" />
</LinearLayout>
