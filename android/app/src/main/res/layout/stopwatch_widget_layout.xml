<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/home_widget_background"
    android:padding="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_widget_label_stopwatch"
        android:textColor="@color/home_widget_label"
        android:textSize="11sp"
        android:letterSpacing="0.1" />

    <Chronometer
        android:id="@+id/chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textColor="@color/home_widget_amber"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_widget_placeholder"
        android:textColor="@color/home_widget_amber"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- RemoteViews can't detect a long press or double tap, so start/pause and reset are two
         separate buttons rather than the app's own long-press/double-tap gestures. Each has its
         own setOnClickPendingIntent in StopwatchWidgetProvider, which takes priority over
         widget_container's own "open the app" PendingIntent within its bounds. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/toggle_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="@string/home_widget_stopwatch_toggle_start_glyph"
            android:contentDescription="@string/home_widget_stopwatch_toggle_start_description"
            android:textColor="@color/home_widget_cyan"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reset_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="@string/home_widget_stopwatch_reset_glyph"
            android:contentDescription="@string/home_widget_stopwatch_reset_description"
            android:textColor="@color/home_widget_label"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
