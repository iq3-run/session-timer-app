<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/home_widget_background"
    android:padding="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_widget_label_timer"
        android:textColor="@color/home_widget_label"
        android:textSize="11sp"
        android:letterSpacing="0.1" />

    <Chronometer
        android:id="@+id/chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textColor="@color/home_widget_amber"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_widget_placeholder"
        android:textColor="@color/home_widget_amber"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- See stopwatch_widget_layout.xml for why this is a stacked structure rather than a single
         weighted row: on-device (BlueStacks, API 28) a Chronometer inside a weighted row didn't
         inflate as coded. Two button rows here because RemoteViews can't detect long press, so
         each of the timer's 4 actions needs its own tappable view (same reason
         StopwatchWidgetProvider splits start/pause and reset into separate views). -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/start_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="@string/home_widget_timer_start_glyph"
            android:contentDescription="@string/home_widget_timer_start_description"
            android:textColor="@color/home_widget_cyan"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reset_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="@string/home_widget_timer_reset_glyph"
            android:contentDescription="@string/home_widget_timer_reset_description"
            android:textColor="@color/home_widget_label"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/add30_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="@string/home_widget_timer_add30_label"
            android:textColor="@color/home_widget_cyan"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/add60_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:gravity="center"
            android:text="@string/home_widget_timer_add1min_label"
            android:textColor="@color/home_widget_cyan"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
