<?xml version="1.0" encoding="utf-8"?>
<!-- 種別・日付・週末間・今日からを1行4列に並べる — 空のセルも列の位置を保つため
     chainGap/todayGap は常にVISIBLEのまま空文字列を許す（GONEで詰めない）。read-only
     スケジュール画面のDataTableが空セルでも列を保持するのと同じ挙動。列幅は
     schedule_widget_layout.xmlのヘッダー行と同じminWidth値を使う。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- wrap_content, not a fixed width: labels range from 2 chars ("OR"/"CR") up to
         multi-digit sequence numbers ("12WE") or full-width text ("次回CR"/"今日") — a fixed
         width risks clipping the longer ones. minWidth just keeps the common short-label case
         reasonably column-aligned. -->
    <TextView
        android:id="@+id/item_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="44dp"
        android:textColor="@color/home_widget_white"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/item_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:minWidth="60dp"
        android:textColor="@color/home_widget_label"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/item_chain_gap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:minWidth="56dp"
        android:textColor="@color/home_widget_label"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/item_today_gap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:minWidth="56dp"
        android:textColor="@color/home_widget_label"
        android:textSize="11sp" />
</LinearLayout>
