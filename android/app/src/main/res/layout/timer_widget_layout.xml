<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/home_widget_background"
    android:padding="12dp">

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_widget_label_timer"
        android:textColor="@color/home_widget_label"
        android:textSize="11sp"
        android:letterSpacing="0.1" />

    <Chronometer
        android:id="@+id/chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textColor="@color/home_widget_amber"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_widget_placeholder"
        android:textColor="@color/home_widget_amber"
        android:textSize="28sp"
        android:textStyle="bold" />
</LinearLayout>
